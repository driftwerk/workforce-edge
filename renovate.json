{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency updates. Minor, patch, pin and digest updates auto-merge once the required checks pass; majors wait for a human. CI and build-image updates are reviewed by hand, because they change what runs on every pull request. The Workforce core crates move by hand with the pinned revision in Cargo.toml.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "before 9am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major updates once required checks pass.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "One PR per ecosystem for non-major updates.",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "js non-major"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo non-major"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions non-major"
    },
    {
      "description": "CI and build-image updates change what runs on every pull request: reviewed by hand.",
      "matchManagers": [
        "github-actions",
        "dockerfile"
      ],
      "automerge": false
    },
    {
      "description": "The Workforce core crates move together, by hand, with the pinned revision.",
      "matchPackageNames": [
        "/^workforce-/"
      ],
      "enabled": false
    }
  ]
}
